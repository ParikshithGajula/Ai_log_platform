# MongoDB connection (MONGO_URI primary; MONGODB_URL/MONGODB_URI fallbacks)
MONGO_URI=mongodb://localhost:27017
MONGODB_URL=mongodb://localhost:27017

# Redis cache / Celery broker
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI API key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Upload cap in bytes (default 10MB) — frontend + worker enforce the same
MAX_UPLOAD_BYTES=10485760

# Optional: comma-separated extra CORS origins (e.g. Vercel, Render frontend)
CORS_EXTRA_ORIGINS=https://your-frontend.vercel.app

# Optional: enable Mongo TTL expiry, e.g. 30 for 30-day log retention.
# Unset (default) keeps logs forever.
LOG_TTL_DAYS=

# Max upload size in MB (legacy informational)
MAX_FILE_SIZE_MB=50

# Log severity level
LOG_LEVEL=INFO
